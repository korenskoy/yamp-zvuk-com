// Шаблон секретов. Скопируйте в Secrets.xcconfig (он в .gitignore) и впишите свои значения.
//   cp Configuration/Secrets.example.xcconfig Configuration/Secrets.xcconfig
// Получить ключ: https://www.last.fm/api/account/create
LASTFM_API_KEY = YOUR_LASTFM_API_KEY
LASTFM_API_SECRET = YOUR_LASTFM_API_SECRET
