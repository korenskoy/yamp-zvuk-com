// MARKETING_VERSION — пользовательская версия (semver), правится вручную при релизе.
// CURRENT_PROJECT_VERSION — build number, инкрементится автоматически в scripts/build-dmg.sh.
MARKETING_VERSION = 1.5.0
CURRENT_PROJECT_VERSION = 161

// Секреты (Last.fm API key/secret) — не в git. Заполняются в Configuration/Secrets.xcconfig
// (шаблон — Secrets.example.xcconfig). "#include?" не падает, если файл отсутствует.
#include? "Secrets.xcconfig"
